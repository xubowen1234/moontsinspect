///|
fn with_crc(prefix : Bytes) -> Bytes {
  let a = prefix.to_array()
  let crc = mpeg_crc32(prefix)
  for shift in [24, 16, 8, 0] {
    a.push((crc >> shift).to_byte())
  }
  Bytes::from_array(a[:])
}

///|
test "MPEG CRC known check vector and independently muxed PAT" {
  assert_eq(mpeg_crc32(b"123456789"), 0x0376e6e7U)
  assert_eq(mpeg_crc32(b""), 0xffffffffU)
  // Extracted from FFmpeg 8.1's synthetic.ts, not generated by this implementation.
  let bytes = b"\x00\xb0\x0d\x00\x01\xc1\x00\x00\x00\x07\xf0\x00\x2e\x62\xef\xa0"
  assert_eq(mpeg_crc32(bytes), 0U)
  let s = parse_section(bytes).unwrap()
  assert_eq(s.table_id, 0)
  assert_eq(s.extension, 1)
  assert_eq(s.body, b"\x00\x07\xf0\x00")
  let bad = bytes.to_fixedarray()
  bad[8] = 0xff
  assert_true(
    parse_section(Bytes::from_array(bad[:])) is Err({ code: "section_crc", .. }),
  )
}

///|
test "section length reserved bits numbering and every truncation" {
  let bytes = with_crc(b"\x00\xb0\x0d\x00\x01\xc1\x00\x00\x00\x07\xf0\x00")
  for n = 0; n < bytes.length(); n = n + 1 {
    assert_true(parse_section(bytes.view(end=n).to_owned()) is Err(_))
  }
  assert_true(
    parse_section(with_crc(b"\x00\x90\x09\x00\x01\xc1\x00\x00"))
    is Err({ code: "section_reserved", .. }),
  )
  assert_true(
    parse_section(with_crc(b"\x00\xb0\x09\x00\x01\xc1\x02\x01"))
    is Err({ code: "section_number", .. }),
  )
}
